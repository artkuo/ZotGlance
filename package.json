{
  "name": "zotglance",
  "type": "module",
  "version": "0.1.1",
  "description": "Quick Look card and better type-to-select for the Zotero items list",
  "config": {
    "addonName": "ZotGlance",
    "addonID": "zotglance@artkuo.dev",
    "addonRef": "zotglance",
    "addonInstance": "ZotGlance",
    "prefsPrefix": "extensions.zotero.zotglance"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/artkuo/ZotGlance.git"
  },
  "author": "Art Kuo",
  "contributors": [
    "Command Code"
  ],
  "bugs": {
    "url": "https://github.com/artkuo/ZotGlance/issues"
  },
  "homepage": "https://github.com/artkuo/ZotGlance#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "update-deps": "npm update --save",
    "test:unit": "node --test test/unit/*.test.ts"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@zotero-plugin/eslint-config": "^0.6.10",
    "eslint": "^9.39.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.4",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
